{
  "name": "vibecentral",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HQ: a private, self-hosted, read-only dashboard for one person",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wrangler dev --port 8787\"",
    "build": "vite build && node scripts/build-static.mjs",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:push": "npx supabase db push",
    "functions:deploy": "npx supabase functions deploy sync --no-verify-jwt",
    "secrets:worker": "wrangler secret bulk .dev.vars",
    "setup": "node scripts/setup.mjs",
    "setup:secrets": "node scripts/setup-secrets.mjs",
    "check": "node scripts/setup-check.mjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.1.0",
    "@simplewebauthn/server": "^13.1.1",
    "@supabase/supabase-js": "^2.49.1",
    "hono": "^4.7.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "concurrently": "^9.1.2",
    "supabase": "^2.20.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "wrangler": "^4.158.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "sharp@0.35.5": true,
    "sharp@0.34.5": true,
    "supabase@2.122.1": true,
    "workerd@1.20261104.1": true
  }
}
