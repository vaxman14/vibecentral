# Copy to .dev.vars (gitignored). Worker secrets. Load into Cloudflare with: npm run secrets:worker
# Provider tokens (Cloudflare, Netlify, Stripe, …) are NOT env vars: you paste them in the dashboard under Connections,
# where they are encrypted with HQ_MASTER_KEY and stored in Supabase.

# --- Supabase (the project you created for HQ) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=                    # Project Settings → API keys → service_role (or a secret key sb_secret_…)

# --- Encryption + shared secrets (generate with: node scripts/gen-secrets.mjs) ---
HQ_MASTER_KEY=                                # 32 random bytes, base64. Same value goes into Supabase Edge Function secrets.
HQ_SYNC_SECRET=                               # random string. Same value in Edge Function secrets and in Vault as hq_sync_secret.
HQ_INGEST_KEY=                                # random string. Only the session hook and usage agent know it. Write-only.

# --- Google OAuth client (sign-in + Gmail/Calendar read-only) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Resend (alerts) ---
RESEND_API_KEY=
ALERT_FROM=HQ <hq@yourdomain.com>

# --- One-time helper (optional): Cloudflare token with DNS:Edit on your sending domain, used only by scripts/resend-dns.mjs ---
CF_DNS_TOKEN=
