{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibecentral",
  "main": "worker/src/index.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist/web", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "workers_dev": true,
  // For a custom domain, replace workers_dev with:  "routes": [{ "pattern": "hq.example.com", "custom_domain": true }]
  // and set APP_ORIGIN / RP_ID below. `npm run setup` does this for you.
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "APP_NAME": "Vibe Central",
    "APP_ORIGIN": "",
    "RP_ID": "",
    "ALLOWED_GOOGLE_EMAILS": ""
  },
  "dev": { "port": 8787 }
}
